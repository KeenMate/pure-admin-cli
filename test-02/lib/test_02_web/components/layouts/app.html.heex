<.layout>
  <.navbar>
    <:start>
      <.navbar_burger />
      <.navbar_brand />
    </:start>
    <:center>
      <.navbar_title>
        <h2>{assigns[:page_title] || "Home"}</h2>
      </.navbar_title>
    </:center>
    <:end_>
      <.navbar_profile_btn name="User" phx-click={toggle_profile_panel()} />
    </:end_>
  </.navbar>

  <.layout_inner>
    <.sidebar>
      <.sidebar_item label="Dashboard" icon="fa-solid fa-gauge" href="/" is_active={assigns[:current_path] == "/"} />
    </.sidebar>

    <.layout_content>
      <.main>
        <.flash_group flash={@flash} />
        {@inner_content}
      </.main>
      <.footer />
    </.layout_content>
  </.layout_inner>
</.layout>

<.profile_panel id="profile-panel" name="User" email="user@example.com" role="User">
  <div class="pa-tabs__panel pa-tabs__panel--active" data-profile-panel="profile">
    <nav class="pa-profile-panel__nav">
      <ul>
        <.profile_nav_item href="#" icon="fa-solid fa-user">Profile Settings</.profile_nav_item>
        <.profile_nav_item href="#" icon="fa-solid fa-lock">Security</.profile_nav_item>
        <.profile_nav_item href="#" icon="fa-solid fa-bell">Notifications</.profile_nav_item>
        <.profile_nav_item href="#" icon="fa-solid fa-gear">Preferences</.profile_nav_item>
      </ul>
    </nav>
  </div>

  <:footer_>
    <button class="pa-btn pa-btn--danger pa-btn--block">
      <i class="fa-solid fa-right-from-bracket"></i> Sign Out
    </button>
  </:footer_>
</.profile_panel>
