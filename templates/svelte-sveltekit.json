{
  "name": "sveltekit",
  "displayName": "SvelteKit",
  "description": "SvelteKit app with Pure Admin components and dynamic theme switching",
  "version": "2.3.4",
  "scaffold": {
    "command": "npx sv create __APP_ID__ --template minimal --types ts --no-add-ons --no-install",
    "fallback": "npm create svelte@latest __APP_ID__ -- --template skeleton --types ts"
  },
  "dependencies": {
    "@keenmate/svelte-pure-admin": "latest",
    "@keenmate/pure-admin-core": "latest"
  },
  "pageTypes": {
    "dashboard": {
      "template": "pages/dashboard.svelte",
      "route": "src/routes/+page.svelte",
      "icon": "fa fa-home",
      "defaultLabel": "Dashboard"
    },
    "list": {
      "template": "pages/list.svelte",
      "route": "src/routes/{{entity}}/+page.svelte",
      "icon": "fa fa-list",
      "defaultLabel": "{{entity}}"
    },
    "detail": {
      "template": "pages/detail.svelte",
      "route": "src/routes/{{entity}}/[id]/+page.svelte",
      "icon": null
    },
    "master-detail": {
      "template": "pages/master-detail.svelte",
      "route": "src/routes/{{entity}}/+page.svelte",
      "icon": "fa fa-table",
      "defaultLabel": "{{entity}}"
    },
    "form": {
      "template": "pages/form.svelte",
      "route": "src/routes/{{entity}}/+page.svelte",
      "icon": "fa fa-edit",
      "defaultLabel": "{{entity}}"
    }
  },
  "defaultPages": [
    { "type": "dashboard", "label": "Dashboard" }
  ],
  "steps": [
    { "action": "create", "path": "src/app.html", "template": "app.html" },
    { "action": "create", "path": "src/app.css", "template": "app.css" },
    { "action": "create", "path": "src/routes/+layout.svelte", "template": "layout.svelte" },
    { "action": "create", "path": "pureadmin.json", "template": "pureadmin.json" },
    { "action": "create", "path": "Makefile", "template": "Makefile" },
    { "action": "create", "path": "README.md", "template": "README.md" },
    { "action": "create", "path": "CHANGELOG.md", "template": "CHANGELOG.md" },
    { "action": "json-merge", "path": "package.json", "data": {
      "scripts": {
        "themes": "pureadmin themes",
        "themes:update": "pureadmin update"
      }
    }}
  ],
  "themeSetup": {
    "themesDir": "static/themes",
    "cssPath": "/themes/__THEME_ID__/css/__THEME_ID__.css"
  },
  "postSteps": [
    "npm install",
    "npx pureadmin themes"
  ],
  "instructions": [
    "cd __APP_ID__",
    "npm run dev",
    "Open http://localhost:5173"
  ]
}
